<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>圆定理侦探社 | 像素风几何解谜 · 完整案件展示</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            image-rendering: crisp-edges;
            image-rendering: pixelated;
        }
        body {
            margin: 0;
            min-height: 100vh;
            background: #0a0c12;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Press Start 2P', 'Courier New', monospace;
            padding: 20px;
        }
        .detective-container {
            background: #0b0e14;
            box-shadow: 0 0 0 4px #3a3f4e, 0 0 0 8px #1e212a, 0 8px 24px black;
            padding: 1.2rem;
            max-width: 1400px;
            width: 100%;
        }
        .game-layout {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            justify-content: center;
        }
        .canvas-stage {
            flex: 3;
            min-width: 500px;
            background: #000000;
            border: 3px solid #5f6a7a;
            box-shadow: inset 0 0 0 2px #2e333d, 4px 4px 0px 0px #1a1c22;
            padding: 0.5rem;
            position: relative;
            cursor: default;
        }
        .canvas-stage::after {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: repeating-linear-gradient(0deg, rgba(0,255,0,0.02) 0px, rgba(0,255,0,0.02) 2px, transparent 2px, transparent 4px);
            pointer-events: none;
        }
        canvas {
            display: block;
            width: 100%;
            background: #101418;
            image-rendering: crisp-edges;
            image-rendering: pixelated;
            cursor: default;
            pointer-events: none;
        }
        .case-panel {
            flex: 1.2;
            min-width: 280px;
            background: #12161f;
            border: 3px solid #4c5568;
            padding: 1rem;
            box-shadow: inset 2px 2px 0px #2a2f3c, 4px 4px 0px #080b10;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .brief {
            background: #0c0f18;
            border-left: 6px solid #7f8c8d;
            padding: 0.8rem;
            box-shadow: inset 0px 1px 0px #2a2e3a, 0 2px 0 #000;
        }
        .brief h2 {
            margin: 0 0 0.5rem;
            font-size: 0.85rem;
            color: #c7e9ff;
            font-weight: normal;
            text-shadow: 2px 2px 0px #1a2a3a;
            line-height: 1.3;
        }
        .brief p {
            margin: 0;
            font-size: 0.65rem;
            color: #9aaec9;
            line-height: 1.4;
            font-family: monospace;
        }
        .status-area {
            background: #080b10;
            border: 2px solid #3a4050;
            padding: 0.6rem;
            font-size: 0.6rem;
            color: #bbd4f0;
            font-family: 'Press Start 2P', monospace;
            line-height: 1.3;
            text-shadow: 1px 1px 0px #000000;
        }
        .clue-box {
            background: #0c0f18;
            border: 2px dashed #5d6b83;
            padding: 0.7rem;
            min-height: 150px;
        }
        .clue-label {
            font-weight: bold;
            color: #e0c87c;
            font-size: 0.55rem;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }
        .clue-content {
            font-size: 0.65rem;
            color: #eef2fa;
            font-family: 'Courier New', monospace;
            word-break: break-word;
            line-height: 1.4;
        }
        .action-buttons {
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
            margin-top: 0.2rem;
        }
        button {
            background: #2a2f3e;
            border: none;
            padding: 0.6rem 0.8rem;
            font-family: 'Press Start 2P', monospace;
            font-size: 0.55rem;
            color: #eef2fa;
            cursor: pointer;
            box-shadow: 0 3px 0 #0f111a;
            transition: 0.05s linear;
            text-transform: uppercase;
        }
        button:active {
            transform: translateY(2px);
            box-shadow: 0 1px 0 #0f111a;
        }
        button.primary { background: #4e5b7c; text-shadow: 1px 1px 0 #1e293b; }
        button.warning { background: #5c4a3a; color: #fadfaa; }
        .badge-row {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-top: 4px;
            justify-content: center;
        }
        .medal {
            background: #1b202b;
            border: 1px solid #4d5a72;
            padding: 4px 6px;
            font-size: 0.5rem;
            font-weight: bold;
            color: #8e9eb5;
            font-family: monospace;
            text-align: center;
        }
        .medal.active { background: #5f7343; color: #f9f2cf; border-color: #e6cd7c; }
        hr { border-top: 2px solid #2e3545; margin: 4px 0; }
        @keyframes pixelBlink { 0% { filter: drop-shadow(0 0 0px #ffffaa);} 50% { filter: drop-shadow(0 0 4px #ffcc77);} 100% { filter: drop-shadow(0 0 0px);} }
        .correct-flash { animation: pixelBlink 0.3s 2; }
        .small-note { font-size: 0.45rem; color: #6e7c94; text-align: center; margin-top: 8px; font-family: monospace; }
        .angle-readout {
            background: #000000aa;
            padding: 6px 8px;
            font-size: 0.55rem;
            font-family: monospace;
            color: #ffd966;
            display: block;
            margin-top: 8px;
            border-left: 3px solid #ffaa44;
            text-align: center;
        }
        .input-group {
            margin-top: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .input-group input {
            background: #1e2330;
            border: 1px solid #5f6a7a;
            color: #ffd966;
            font-family: monospace;
            font-size: 0.6rem;
            padding: 6px 8px;
            width: 70px;
            text-align: center;
        }
        .input-group button {
            padding: 6px 12px;
            font-size: 0.5rem;
            background: #4e5b7c;
        }
        .success-badge {
            background: #5f7343;
            color: #f9f2cf;
            padding: 4px 8px;
            font-size: 0.5rem;
            text-align: center;
            margin-top: 8px;
            border-radius: 2px;
        }
        .observation-tip {
            font-size: 0.5rem;
            color: #b8c7e7;
            margin-top: 6px;
            text-align: center;
        }
        .case-counter {
            font-size: 0.5rem;
            color: #ffaa66;
            text-align: center;
            margin-top: 5px;
        }
    </style>
</head>
<body>
<div class="detective-container">
    <div class="game-layout">
        <div class="canvas-stage">
            <canvas id="geometryCanvas" width="720" height="540" style="width:100%; height:auto; image-rendering: crisp-edges;"></canvas>
            <div class="small-note">🔍 观察几何图形 | 推理定理关系 | 点击「下一案件」浏览全部5个定理</div>
        </div>
        <div class="case-panel">
            <div class="brief" id="caseBrief">
                <h2>CASE #01: 剧院舞台灯错位</h2>
                <p>观察两个扇形灯光，圆心角相等时弧长相待，舞台灯光校准</p>
            </div>
            <div class="status-area" id="statusMsg">
                📋 侦探手册<br>
                仔细观察图形中的数据，理解定理含义
            </div>
            <div class="clue-box">
                <div class="clue-label">📜 定理线索手册</div>
                <div class="clue-content" id="clueText">当前案件对应的圆定理将在这里展示</div>
                <div id="mistakeTip" style="font-size:0.5rem; margin-top:6px; color:#e2bc7c;"></div>
                <div id="liveReadout" class="angle-readout">📐 测量数据: --</div>
                <div id="interactiveInput" class="input-group"></div>
                <div id="successMsg" class="success-badge" style="display:none;">✨ 定理理解成功 ✨</div>
            </div>
            <div class="action-buttons">
                <button id="resetBtn" class="warning">🔄 重置视图</button>
                <button id="nextCaseBtn" class="primary">🔍 下一案件 →</button>
                <button id="prevCaseBtn" class="primary">← 上一案件</button>
            </div>
            <hr>
            <div class="badge-row" id="badgeContainer"></div>
            <div class="case-counter" id="caseCounter">案件 1 / 5</div>
            <div class="observation-tip">💡 提示：每个案件展示一个圆定理的几何图形，观察角度/长度关系</div>
        </div>
    </div>
</div>

<script>
(function(){
    // ========== 辅助函数 ==========
    function computeAngle(ax, ay, bx, by, cx, cy) {
        let baX = ax - bx, baY = ay - by;
        let bcX = cx - bx, bcY = cy - by;
        let dot = baX*bcX + baY*bcY;
        let mag = Math.hypot(baX, baY) * Math.hypot(bcX, bcY);
        if(mag === 0) return 0;
        return Math.acos(Math.min(1, Math.max(-1, dot/mag)));
    }
    
    function getAngleDiffRad(a, b) {
        let diff = Math.abs(a - b);
        return Math.min(diff, 2*Math.PI - diff);
    }
    
    // 绘制扇形
    function drawSector(cx, cy, r, startAng, endAng, color) {
        let a1 = startAng, a2 = endAng;
        let diff = getAngleDiffRad(a1, a2);
        if(Math.abs(a1 - a2) > Math.PI) {
            if(a1 < a2) a1 += 2*Math.PI;
            else a2 += 2*Math.PI;
        }
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, r, a1, a2);
        ctx.closePath();
        ctx.fillStyle = color;
        ctx.fill();
    }
    
    function drawPoint(x, y, color, label) {
        ctx.fillStyle = color;
        ctx.fillRect(x-5, y-5, 10, 10);
        if(label) {
            ctx.fillStyle = "#dddd99";
            ctx.font = "bold 11px 'Courier New'";
            ctx.fillText(label, x-8, y-8);
        }
    }
    
    let canvas = document.getElementById('geometryCanvas');
    let ctx = canvas.getContext('2d');
    let w = 720, h = 540;
    canvas.width = w; canvas.height = h;
    
    // ========== 几何状态 (静态观察用，不可拖拽) ==========
    let geom = {
        cx: w/2, cy: h/2 - 8, r: 170,
        // case0: 两个圆心角
        angA: 0.9, angB: 2.4,   // 约86°
        angC: 2.7, angD: 4.0,   // 约74°
        // case1: 圆周角定理
        fixedA: 0.8, fixedB: 2.5,
        soldierP: 3.4,
        // case2: 垂径定理
        chord1: 1.2, chord2: 2.1,
        // case3: 四边形顶点
        quadAngles: [0.6, 2.0, 2.9, 4.2],
        // case4: 切线长
        externP: { x: 540, y: 190 },
        externQ: { x: 610, y: 270 }
    };
    
    let currentCaseIdx = 0;
    let solvedBadges = [false, false, false, false, false];
    
    // 案件定义 (完整5个定理，图形精美，展示圆角和扇形等元素)
    const CASES = [
        {
            id:0, name:"圆心角定理", title:"CASE #01: 剧院舞台灯错位",
            desc:"🎭 舞台灯光偏移，需要调整圆心角使两束灯光覆盖等长观众区。",
            theorem:"[圆心角定理] 在同圆或等圆中，相等的圆心角所对的弧相等，所对的弦相等。",
            detail:"观察两个扇形：∠AOB 和 ∠COD，当它们相等时，弧长相等，灯光校准。",
            getReadout:() => {
                let angleAOB = Math.round(getAngleDiffRad(geom.angA, geom.angB) * 180 / Math.PI);
                let angleCOD = Math.round(getAngleDiffRad(geom.angC, geom.angD) * 180 / Math.PI);
                return `∠AOB = ${angleAOB}°  |  ∠COD = ${angleCOD}°`;
            },
            drawCustom: () => {
                drawSector(geom.cx, geom.cy, geom.r, geom.angA, geom.angB, "rgba(220, 120, 80, 0.6)");
                drawSector(geom.cx, geom.cy, geom.r, geom.angC, geom.angD, "rgba(80, 160, 220, 0.6)");
                drawPoint(geom.cx+geom.r*Math.cos(geom.angA), geom.cy+geom.r*Math.sin(geom.angA), "#ffaa66", "A");
                drawPoint(geom.cx+geom.r*Math.cos(geom.angB), geom.cy+geom.r*Math.sin(geom.angB), "#ffaa66", "B");
                drawPoint(geom.cx+geom.r*Math.cos(geom.angC), geom.cy+geom.r*Math.sin(geom.angC), "#88ccff", "C");
                drawPoint(geom.cx+geom.r*Math.cos(geom.angD), geom.cy+geom.r*Math.sin(geom.angD), "#88ccff", "D");
                ctx.fillStyle = "#ffaa77";
                ctx.font = "10px monospace";
                ctx.fillText("扇形AOB (暖色灯光)", geom.cx-70, geom.cy-45);
                ctx.fillText("扇形COD (冷色灯光)", geom.cx+20, geom.cy-60);
                // 圆心标注
                ctx.fillStyle = "#aaaaff";
                ctx.fillText("● 圆心O", geom.cx+8, geom.cy+8);
            }
        },
        {
            id:1, name:"圆周角定理", title:"CASE #02: 古堡瞭望塔",
            desc:"🏰 瞭望塔顶有探照灯(圆心角)，士兵P需要站在圆周上找到最佳观测点。",
            theorem:"[圆周角定理] 同弧所对的圆周角等于圆心角的一半。",
            detail:"观察 ∠AOB (圆心角) 和 ∠APB (圆周角) 的度数关系。",
            getReadout:() => {
                let centerAng = getAngleDiffRad(geom.fixedA, geom.fixedB);
                let ax = geom.cx+geom.r*Math.cos(geom.fixedA);
                let ay = geom.cy+geom.r*Math.sin(geom.fixedA);
                let bx = geom.cx+geom.r*Math.cos(geom.fixedB);
                let by = geom.cy+geom.r*Math.sin(geom.fixedB);
                let px = geom.cx+geom.r*Math.cos(geom.soldierP);
                let py = geom.cy+geom.r*Math.sin(geom.soldierP);
                let angleAPB = computeAngle(ax, ay, px, py, bx, by);
                return `∠AOB = ${Math.round(centerAng*180/Math.PI)}°  |  ∠APB = ${Math.round(angleAPB*180/Math.PI)}°`;
            },
            drawCustom: () => {
                let ax = geom.cx+geom.r*Math.cos(geom.fixedA);
                let ay = geom.cy+geom.r*Math.sin(geom.fixedA);
                let bx = geom.cx+geom.r*Math.cos(geom.fixedB);
                let by = geom.cy+geom.r*Math.sin(geom.fixedB);
                let px = geom.cx+geom.r*Math.cos(geom.soldierP);
                let py = geom.cy+geom.r*Math.sin(geom.soldierP);
                // 扇形灯光效果
                drawSector(geom.cx, geom.cy, geom.r, geom.fixedA, geom.fixedB, "rgba(255, 200, 80, 0.35)");
                ctx.beginPath();
                ctx.moveTo(ax, ay);
                ctx.lineTo(px, py);
                ctx.lineTo(bx, by);
                ctx.strokeStyle = "#ffaa66";
                ctx.lineWidth = 2.5;
                ctx.stroke();
                drawPoint(px, py, "#ffcc77", "P");
                drawPoint(ax, ay, "#88aaff", "A");
                drawPoint(bx, by, "#ffaa88", "B");
                ctx.fillStyle = "#ffdd99";
                ctx.font = "9px monospace";
                ctx.fillText("探照灯光(圆心角)", geom.cx-55, geom.cy-35);
                ctx.fillStyle = "#ffaa77";
                ctx.fillText("观察员P (圆周角)", px-25, py-12);
            }
        },
        {
            id:2, name:"垂径定理", title:"CASE #03: 古桥石拱裂缝",
            desc:"🌉 石拱桥出现裂缝，需要让桥柱(直径)垂直于拱弦才能修复。",
            theorem:"[垂径定理] 垂直于弦的直径平分这条弦，并且平分弦所对的两条弧。",
            detail:"观察直径(竖直线)是否垂直于弦CD，并且平分弦。",
            getReadout:() => {
                let x1 = geom.cx+geom.r*Math.cos(geom.chord1);
                let y1 = geom.cy+geom.r*Math.sin(geom.chord1);
                let x2 = geom.cx+geom.r*Math.cos(geom.chord2);
                let y2 = geom.cy+geom.r*Math.sin(geom.chord2);
                let chordVecX = x2-x1, chordVecY = y2-y1;
                let dot = chordVecX*0 + chordVecY*1;
                let len = Math.hypot(chordVecX, chordVecY);
                let isPerp = len > 0.1 ? Math.abs(dot) / len < 0.12 : false;
                let midX = (x1+x2)/2;
                let isBisect = Math.abs(midX - geom.cx) < 12;
                return `垂直: ${isPerp ? "✓ 是" : "✗ 否"}  |  平分: ${isBisect ? "✓ 是" : "✗ 否"}`;
            },
            drawCustom: () => {
                let x1 = geom.cx+geom.r*Math.cos(geom.chord1);
                let y1 = geom.cy+geom.r*Math.sin(geom.chord1);
                let x2 = geom.cx+geom.r*Math.cos(geom.chord2);
                let y2 = geom.cy+geom.r*Math.sin(geom.chord2);
                // 拱弦
                ctx.beginPath();
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.strokeStyle = "#eebb77";
                ctx.lineWidth = 4;
                ctx.stroke();
                // 直径(桥柱)
                ctx.beginPath();
                ctx.moveTo(geom.cx, geom.cy-geom.r);
                ctx.lineTo(geom.cx, geom.cy+geom.r);
                ctx.strokeStyle = "#aaaaee";
                ctx.lineWidth = 3;
                ctx.stroke();
                drawPoint(x1, y1, "#eebb77", "C");
                drawPoint(x2, y2, "#eebb77", "D");
                ctx.fillStyle = "#ccaa77";
                ctx.fillText("拱弦CD", (x1+x2)/2-25, (y1+y2)/2-12);
                ctx.fillStyle = "#aaaaff";
                ctx.fillText("桥柱(直径)", geom.cx+8, geom.cy-30);
                // 中点标记
                let midX = (x1+x2)/2, midY = (y1+y2)/2;
                ctx.fillStyle = "#ffffaa";
                ctx.fillRect(midX-2, midY-2, 4, 4);
            }
        },
        {
            id:3, name:"圆内接四边形定理", title:"CASE #04: 航海罗盘刻度",
            desc:"🧭 航海罗盘刻度偏移，需要让四边形对角和为180°才能校准方向。",
            theorem:"[圆内接四边形定理] 圆内接四边形的对角互补(和为180°)。",
            detail:"观察四边形ABCD四个内角，对角之和应为180°。",
            getReadout:() => {
                let pts = geom.quadAngles.map(ang=>({x: geom.cx+geom.r*Math.cos(ang), y: geom.cy+geom.r*Math.sin(ang)}));
                let angles = [];
                for(let i=0;i<4;i++){
                    let prev = pts[(i+3)%4];
                    let curr = pts[i];
                    let next = pts[(i+1)%4];
                    let ang = computeAngle(prev.x, prev.y, curr.x, curr.y, next.x, next.y);
                    angles.push(Math.round(ang*180/Math.PI));
                }
                return `∠A=${angles[0]}° ∠B=${angles[1]}° ∠C=${angles[2]}° ∠D=${angles[3]}° | A+C=${angles[0]+angles[2]}°`;
            },
            drawCustom: () => {
                // 罗盘外圈刻度
                for(let i=0;i<360;i+=30){
                    let rad = i*Math.PI/180;
                    let xo = geom.cx + (geom.r+12)*Math.cos(rad);
                    let yo = geom.cy + (geom.r+12)*Math.sin(rad);
                    ctx.fillStyle = "#b8a56a";
                    ctx.fillRect(xo-2, yo-2, 4,4);
                }
                // 尖角实心六芒星 (两个正三角形交错)
                let starR = geom.r * 0.48;
                // 正三角形 (朝上)
                ctx.beginPath();
                for(let i=0; i<3; i++) {
                    let ang = -Math.PI/2 + i * 2*Math.PI/3;
                    let x = geom.cx + starR * Math.cos(ang);
                    let y = geom.cy + starR * Math.sin(ang);
                    if(i===0) ctx.moveTo(x,y);
                    else ctx.lineTo(x,y);
                }
                ctx.closePath();
                ctx.fillStyle = "#d4af37cc";
                ctx.fill();
                ctx.strokeStyle = "#f5cb5c";
                ctx.stroke();
                // 倒三角形 (朝下)
                ctx.beginPath();
                for(let i=0; i<3; i++) {
                    let ang = Math.PI/2 + i * 2*Math.PI/3;
                    let x = geom.cx + starR * Math.cos(ang);
                    let y = geom.cy + starR * Math.sin(ang);
                    if(i===0) ctx.moveTo(x,y);
                    else ctx.lineTo(x,y);
                }
                ctx.closePath();
                ctx.fillStyle = "#eac54fcc";
                ctx.fill();
                ctx.strokeStyle = "#ffdf88";
                ctx.stroke();
                // 中心点
                ctx.fillStyle = "#ffaa44";
                ctx.fillRect(geom.cx-3, geom.cy-3, 6, 6);
                
                // 四边形
                let pts = geom.quadAngles.map(ang=>({x: geom.cx+geom.r*Math.cos(ang), y: geom.cy+geom.r*Math.sin(ang)}));
                ctx.beginPath();
                ctx.moveTo(pts[0].x, pts[0].y);
                for(let i=1;i<pts.length;i++) ctx.lineTo(pts[i].x, pts[i].y);
                ctx.closePath();
                ctx.strokeStyle = "#eecd99";
                ctx.lineWidth = 2.5;
                ctx.stroke();
                for(let i=0;i<pts.length;i++) {
                    drawPoint(pts[i].x, pts[i].y, "#ffcc77", String.fromCharCode(65+i));
                }
                ctx.fillStyle = "#ffdd99";
                ctx.font = "9px monospace";
                ctx.fillText("罗盘指针", geom.cx-25, geom.cy-20);
            }
        },
        {
            id:4, name:"切线长定理", title:"CASE #05: 花园喷泉",
            desc:"💧 花园喷泉水管漏水，需要让两条切线长度相等才能均匀喷水。",
            theorem:"[切线长定理] 从圆外一点引圆的两条切线，它们的切线长相等。",
            detail:"观察从P点到A点的切线长度，和从P'点到B点的切线长度，它们应该相等。",
            getReadout:() => {
                let ax = geom.cx + geom.r * Math.cos(geom.fixedA);
                let ay = geom.cy + geom.r * Math.sin(geom.fixedA);
                let bx = geom.cx + geom.r * Math.cos(geom.fixedB);
                let by = geom.cy + geom.r * Math.sin(geom.fixedB);
                let lenAP = Math.hypot(geom.externP.x - ax, geom.externP.y - ay);
                let lenBP = Math.hypot(geom.externQ.x - bx, geom.externQ.y - by);
                return `PA = ${Math.round(lenAP)} px  |  P'B = ${Math.round(lenBP)} px`;
            },
            drawCustom: () => {
                let ax = geom.cx + geom.r * Math.cos(geom.fixedA);
                let ay = geom.cy + geom.r * Math.sin(geom.fixedA);
                let bx = geom.cx + geom.r * Math.cos(geom.fixedB);
                let by = geom.cy + geom.r * Math.sin(geom.fixedB);
                drawPoint(ax, ay, "#88aaff", "A");
                drawPoint(bx, by, "#88aaff", "B");
                // 切线线段
                ctx.beginPath();
                ctx.moveTo(geom.externP.x, geom.externP.y);
                ctx.lineTo(ax, ay);
                ctx.strokeStyle = "#ffaa77";
                ctx.lineWidth = 2.5;
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(geom.externQ.x, geom.externQ.y);
                ctx.lineTo(bx, by);
                ctx.strokeStyle = "#77ffaa";
                ctx.stroke();
                drawPoint(geom.externP.x, geom.externP.y, "#ffaa77", "P");
                drawPoint(geom.externQ.x, geom.externQ.y, "#77ffaa", "P'");
                ctx.fillStyle = "#ffaa77";
                ctx.font = "9px monospace";
                ctx.fillText("水管PA", geom.externP.x-25, geom.externP.y-10);
                ctx.fillStyle = "#77ffaa";
                ctx.fillText("水管P'B", geom.externQ.x-28, geom.externQ.y-10);
                // 辅助虚线圆
                ctx.beginPath();
                ctx.arc(geom.cx, geom.cy, geom.r, 0, 2*Math.PI);
                ctx.strokeStyle = "#6a7a8e";
                ctx.setLineDash([5, 5]);
                ctx.stroke();
                ctx.setLineDash([]);
            }
        }
    ];
    
    function getCurrentState() { return geom; }
    
    // 更新UI (显示当前案件的图形和测量数据)
    function updateUI() {
        let caseData = CASES[currentCaseIdx];
        
        // 更新简报
        document.getElementById('caseBrief').innerHTML = `
            <h2>${caseData.title}</h2>
            <p>${caseData.desc}</p>
        `;
        
        // 更新线索手册
        document.getElementById('clueText').innerHTML = `
            <strong style="color:#ffcc88;">${caseData.theorem}</strong><br><br>
            ${caseData.detail}
        `;
        
        // 更新测量读数
        let readout = caseData.getReadout();
        document.getElementById('liveReadout').innerHTML = `📐 ${readout}`;
        
        // 更新状态提示
        document.getElementById('statusMsg').innerHTML = `📋 案件 ${currentCaseIdx+1}/5<br>观察图形，理解${caseData.name}的几何关系`;
        
        // 更新案件计数器
        document.getElementById('caseCounter').innerHTML = `🔍 案件 ${currentCaseIdx+1} / 5 · ${caseData.name}`;
        
        // 更新徽章显示 (展示哪些案件已浏览/理解)
        updateBadges();
        
        // 隐藏验证输入框 (展示模式，不需要填写验证)
        document.getElementById('interactiveInput').innerHTML = `<div style="color:#8bc34a; font-size:0.55rem;">✨ 观察图形中的角度/长度关系，理解定理内容 ✨</div>`;
        document.getElementById('successMsg').style.display = "none";
        document.getElementById('mistakeTip').innerHTML = "💡 点击「下一案件」浏览所有圆定理的几何演示";
        
        // 重绘画布
        drawCanvas();
    }
    
    function drawCanvas() {
        ctx.clearRect(0, 0, w, h);
        // 背景网格 (像素风格)
        ctx.fillStyle = "#0c1020";
        ctx.fillRect(0, 0, w, h);
        ctx.strokeStyle = "#2a2f3a";
        ctx.lineWidth = 0.5;
        for(let i=0;i<w;i+=30){
            ctx.beginPath();
            ctx.moveTo(i,0);
            ctx.lineTo(i,h);
            ctx.stroke();
        }
        for(let i=0;i<h;i+=30){
            ctx.beginPath();
            ctx.moveTo(0,i);
            ctx.lineTo(w,i);
            ctx.stroke();
        }
        
        // 绘制圆
        ctx.beginPath();
        ctx.arc(geom.cx, geom.cy, geom.r, 0, 2*Math.PI);
        ctx.strokeStyle = "#8c9bb0";
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.fillStyle = "#1e2432aa";
        ctx.fill();
        
        // 绘制当前案件的特定图形
        let caseData = CASES[currentCaseIdx];
        caseData.drawCustom();
        
        // 额外标注圆心
        ctx.fillStyle = "#ffaa66";
        ctx.fillRect(geom.cx-2, geom.cy-2, 4, 4);
    }
    
    function resetCase() {
        // 重置为每个案件的默认几何值 (让图形清晰可读)
        if(currentCaseIdx === 0) {
            geom.angA = 0.9; geom.angB = 2.4;
            geom.angC = 2.7; geom.angD = 4.0;
        } else if(currentCaseIdx === 1) {
            geom.fixedA = 0.8; geom.fixedB = 2.5;
            geom.soldierP = 3.4;
        } else if(currentCaseIdx === 2) {
            geom.chord1 = 1.2; geom.chord2 = 2.1;
        } else if(currentCaseIdx === 3) {
            geom.quadAngles = [0.6, 2.0, 2.9, 4.2];
        } else if(currentCaseIdx === 4) {
            geom.externP = { x: 540, y: 190 };
            geom.externQ = { x: 610, y: 270 };
        }
        drawCanvas();
        updateUI();
    }
    
    function nextCase() {
        currentCaseIdx = (currentCaseIdx + 1) % 5;
        resetCase();
    }
    
    function prevCase() {
        currentCaseIdx = (currentCaseIdx - 1 + 5) % 5;
        resetCase();
    }
    
    function updateBadges() {
        let container = document.getElementById('badgeContainer');
        container.innerHTML = CASES.map((c, i) => {
            let isActive = (i === currentCaseIdx);
            return `<div class="medal ${isActive ? 'active' : ''}" style="${isActive ? 'border:2px solid #ffaa66;' : ''}">
                        ${c.name.slice(0,4)}
                    </div>`;
        }).join('');
    }
    
    // 绑定事件
    document.getElementById('resetBtn').addEventListener('click', resetCase);
    document.getElementById('nextCaseBtn').addEventListener('click', nextCase);
    document.getElementById('prevCaseBtn').addEventListener('click', prevCase);
    
    // 初始化
    updateUI();
    drawCanvas();
})();
</script>
</body>
</html>
